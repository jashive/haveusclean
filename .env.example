# ServiceOS Feature Flags
#
# ALL flags default to false/off.
# Do NOT enable in production configuration.

# Wave 1 — Auth / canonical access
VITE_SERVICEOS_ENABLED=false

# Wave 2 — Revenue pipeline
VITE_SERVICEOS_REVENUE_ENABLED=false
VITE_SERVICEOS_REVENUE_PILOT_UI=false

# Wave 3 — Operations pipeline (NEW)
# Must be true for any Wave 3 network calls to execute.
VITE_SERVICEOS_OPERATIONS_ENABLED=false
# Requires VITE_SERVICEOS_OPERATIONS_ENABLED=true to take effect.
VITE_SERVICEOS_OPERATIONS_PILOT_UI=false
# Requires VITE_SERVICEOS_OPERATIONS_ENABLED=true to take effect.
VITE_SERVICEOS_WAVE4_PILOT_UI=false

# Supabase connection (required for all ServiceOS features)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

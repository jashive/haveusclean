# ServiceOS Feature Flags
#
# ALL flags default to false/off.
# Do NOT enable in production configuration.

# Wave 1 — Auth / canonical access
VITE_SERVICEOS_ENABLED=false
VITE_SERVICEOS_AUTH_ENABLED=false

# Wave 2 — Revenue pipeline
VITE_SERVICEOS_REVENUE_ENABLED=false
VITE_SERVICEOS_REVENUE_PILOT_UI=false

# Wave 3 — Operations pipeline (NEW)
# Must be true for any Wave 3 network calls to execute.
VITE_SERVICEOS_OPERATIONS_ENABLED=false
# Requires VITE_SERVICEOS_OPERATIONS_ENABLED=true to take effect.
VITE_SERVICEOS_OPERATIONS_PILOT_UI=false
# Requires VITE_SERVICEOS_OPERATIONS_ENABLED=true to take effect.
VITE_SERVICEOS_WAVE4_PILOT_UI=false

# Wave 5 Finance (billing, invoicing, QB sync, payment, contractor pay) — default OFF
VITE_SERVICEOS_FINANCE_ENABLED=false
# Requires VITE_SERVICEOS_FINANCE_ENABLED=true to take effect.
VITE_SERVICEOS_WAVE5_PILOT_UI=false

# Growth Layer 1.0 — independently gated from ServiceOS core. ALL default OFF.
# Enables Growth UI/read paths only; does not authorize outbound sending or ServiceOS handoff.
VITE_GROWTH_LAYER_ENABLED=false
# Server-side master gate for Growth workflows and private growth schema access.
GROWTH_LAYER_ENABLED=false
# Must remain false until suppression, opt-out, dedupe, bounce/complaint and deliverability controls pass.
GROWTH_OUTREACH_ENABLED=false
# Must remain false until sequence stop-on-reply and follow-up controls pass acceptance.
GROWTH_AUTO_FOLLOWUP_ENABLED=false
# Must remain false until the governed Growth-to-ServiceOS adapter passes acceptance tests.
GROWTH_SERVICEOS_HANDOFF_ENABLED=false

# Supabase connection (required for all ServiceOS features)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployment isolation (required for ServiceOS preview/acceptance)
# VITE_SERVICEOS_ENVIRONMENT=acceptance
# VITE_SUPABASE_URL=https://<approved-project-ref>.supabase.co
# VITE_SUPABASE_ANON=
# Server-only: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# Server-only environment: SERVICEOS_ENVIRONMENT=preview|test|production
# Server-only Production approval: SERVICEOS_PRODUCTION_APPROVED=true (Production only)
# Mutation runners only: SERVICEOS_ACCEPTANCE_MUTATIONS_APPROVED=true
# Production requires VITE_SERVICEOS_ENVIRONMENT=production and an explicit
# VITE_SERVICEOS_PRODUCTION_APPROVED=true deployment control.
